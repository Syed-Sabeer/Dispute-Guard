APP_NAME="Dispute Guard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE-WITH-PRODUCTION-DOMAIN.invalid

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chargeguard
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Dispute Guard"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CHARGEGUARD_NAME="Dispute Guard"
# Global customer-email safety switch; merchant automation still defaults off.
CHARGEGUARD_TEST_MODE=false
CHARGEGUARD_DEMO_MODE=false
DISPUTEGUARD_ENABLE_TEST_TOOLS=false
# Private prelaunch only. Empty allowlist fails closed. Set billing true before public launch.
BILLING_ENABLED=false
DISPUTEGUARD_PRELAUNCH=true
DISPUTEGUARD_PRELAUNCH_SHOPS=
CHARGEGUARD_RETENTION_DAYS=90
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_HANDLE=
SHOPIFY_BILLING_MODE=app_pricing
SHOPIFY_PARTNER_ID=
SHOPIFY_PARTNER_TOKEN=
SHOPIFY_APP_ID=
SHOPIFY_PARTNER_API_VERSION=2026-07
SHOPIFY_PLAN_STARTER=starter
SHOPIFY_PLAN_GROWTH=growth
SHOPIFY_PLAN_PRO=pro
SHOPIFY_ITEM_STARTER=starter
SHOPIFY_ITEM_GROWTH=growth
SHOPIFY_ITEM_PRO=pro
# Legacy local-only bypass stays disabled; production always ignores false.
BILLING_ENFORCED=true
